# Copy to .env and fill in. Never commit .env.

# Tiers M and L (needed from M1). Same key as Scout is fine.
ANTHROPIC_API_KEY=

# Request log (M6). Default: a local SQLite file. Docker Compose sets a Postgres URL.
DATABASE_URL=sqlite:///gearbox_local.db

# Answer cache (M7). Empty = in-memory cache inside the process. Compose sets Redis.
REDIS_URL=

LOG_LEVEL=INFO
CONFIG_PATH=config.yaml
